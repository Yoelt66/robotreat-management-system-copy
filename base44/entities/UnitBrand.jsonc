{
  "name": "UnitBrand",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05d5\u05ea\u05d2"
    },
    "unit_types": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "\u05e1\u05d5\u05d2\u05d9 \u05d9\u05d7\u05d9\u05d3\u05d5\u05ea \u05d0\u05e4\u05e9\u05e8\u05d9\u05d9\u05dd \u05dc\u05de\u05d5\u05ea\u05d2"
    },
    "default_visit_interval_months": {
      "type": "number",
      "default": 3,
      "description": "\u05de\u05e8\u05d5\u05d5\u05d7 \u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc \u05d1\u05d9\u05df \u05d1\u05d9\u05e7\u05d5\u05e8\u05d9\u05dd \u05d1\u05d7\u05d5\u05d3\u05e9\u05d9\u05dd"
    },
    "default_visit_sequence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_number": {
            "type": "number"
          },
          "maintenance_type_id": {
            "type": "string"
          },
          "interval_months": {
            "type": "number",
            "default": 3,
            "description": "\u05de\u05e8\u05d5\u05d5\u05d7 \u05dc\u05e4\u05e0\u05d9 \u05e9\u05dc\u05d1 \u05d6\u05d4 \u05d1\u05d7\u05d5\u05d3\u05e9\u05d9\u05dd"
          }
        }
      },
      "default": [],
      "description": "\u05e8\u05e6\u05e3 \u05d1\u05d9\u05e7\u05d5\u05e8\u05d9\u05dd \u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc \u05e2\u05dd \u05d0\u05d9\u05e0\u05d8\u05e8\u05d5\u05d5\u05dc\u05d9\u05dd"
    },
    "default_sequences_by_unit_type": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "unit_type": {
            "type": "string",
            "description": "\u05e1\u05d5\u05d2 \u05d9\u05d7\u05d9\u05d3\u05d4 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9"
          },
          "sequence": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "step_number": {
                  "type": "number"
                },
                "maintenance_type_id": {
                  "type": "string"
                },
                "interval_months": {
                  "type": "number",
                  "default": 3,
                  "description": "\u05de\u05e8\u05d5\u05d5\u05d7 \u05dc\u05e4\u05e0\u05d9 \u05e9\u05dc\u05d1 \u05d6\u05d4 \u05d1\u05d7\u05d5\u05d3\u05e9\u05d9\u05dd"
                }
              }
            },
            "default": []
          }
        }
      },
      "default": [],
      "description": "\u05e8\u05e6\u05e4\u05d9 \u05d1\u05d9\u05e7\u05d5\u05e8\u05d9\u05dd \u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc \u05dc\u05e4\u05d9 \u05e1\u05d5\u05d2 \u05d9\u05d7\u05d9\u05d3\u05d4"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
{
  "name": "MaintenanceType",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e1\u05d5\u05d2 \u05d4\u05ea\u05d7\u05d6\u05d5\u05e7\u05d4"
    },
    "brand_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05d5\u05ea\u05d2 - \u05e9\u05d9\u05d5\u05da \u05e1\u05d5\u05d2 \u05ea\u05d7\u05d6\u05d5\u05e7\u05d4 \u05dc\u05de\u05d5\u05ea\u05d2 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9"
    },
    "unit_type": {
      "type": "string",
      "description": "\u05e1\u05d5\u05d2 \u05d9\u05d7\u05d9\u05d3\u05d4 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05ea\u05d7\u05ea \u05d4\u05de\u05d5\u05ea\u05d2"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8"
    },
    "step_configs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_id": {
            "type": "string",
            "description": "ID \u05e9\u05dc \u05e4\u05e2\u05d5\u05dc\u05ea \u05d4\u05ea\u05d7\u05d6\u05d5\u05e7\u05d4 \u05de\u05d4-MaintenanceStep"
          },
          "step_name": {
            "type": "string",
            "description": "\u05e9\u05dd \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 (\u05dc\u05e0\u05d5\u05d7\u05d5\u05ea)"
          },
          "enabled": {
            "type": "boolean",
            "default": true
          },
          "custom_parts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "part_sku": {
                  "type": "string"
                },
                "part_name": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                }
              }
            },
            "default": []
          }
        }
      },
      "default": [],
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05e4\u05e2\u05d5\u05dc\u05d5\u05ea \u05d4\u05ea\u05d7\u05d6\u05d5\u05e7\u05d4 \u05d4\u05db\u05dc\u05d5\u05dc\u05d5\u05ea \u05d1\u05e1\u05d5\u05d2 \u05d6\u05d4 \u05e2\u05dd \u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05db\u05de\u05d5\u05d9\u05d5\u05ea"
    },
    "estimated_duration_hours": {
      "type": "number",
      "description": "\u05de\u05e9\u05da \u05d6\u05de\u05df \u05de\u05e9\u05d5\u05e2\u05e8 \u05d1\u05e9\u05e2\u05d5\u05ea"
    },
    "color": {
      "type": "string",
      "description": "\u05e6\u05d1\u05e2 \u05dc\u05ea\u05e6\u05d5\u05d2\u05d4"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
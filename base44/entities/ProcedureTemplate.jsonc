{
  "name": "ProcedureTemplate",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e0\u05d5\u05d4\u05dc \u05d4\u05ea\u05d7\u05d6\u05d5\u05e7\u05d4 (\u05dc\u05de\u05e9\u05dc '\u05d8\u05d9\u05e4\u05d5\u05dc 6 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd')"
    },
    "device_type": {
      "type": "string",
      "enum": [
        "Astronaut_A3",
        "Astronaut_A3N",
        "Astronaut_A4",
        "Delaval_2008",
        "Delaval_2011",
        "Milk_tank",
        "CRS",
        "Juno_100",
        "Juno_150",
        "Luna",
        "other"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05db\u05e9\u05d9\u05e8 \u05e9\u05d4\u05e0\u05d5\u05d4\u05dc \u05de\u05d9\u05d5\u05e2\u05d3 \u05dc\u05d5"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_id": {
            "type": "string"
          },
          "is_optional": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "step_id"
        ]
      },
      "default": [],
      "description": "\u05de\u05e2\u05e8\u05da \u05e9\u05dc \u05e9\u05dc\u05d1\u05d9\u05dd \u05d4\u05db\u05dc\u05d5\u05dc\u05d9\u05dd \u05d1\u05e0\u05d5\u05d4\u05dc \u05d6\u05d4, \u05e2\u05dd \u05d3\u05d2\u05dc \u05d4\u05de\u05e6\u05d9\u05d9\u05df \u05d0\u05dd \u05d4\u05e9\u05dc\u05d1 \u05d4\u05d5\u05d0 \u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05e0\u05d5\u05d4\u05dc \u05e4\u05e2\u05d9\u05dc"
    }
  },
  "required": [
    "name",
    "device_type"
  ]
}
{
  "name": "Maintenance",
  "type": "object",
  "properties": {
    "unit_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d9\u05d7\u05d9\u05d3\u05d4"
    },
    "customer_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "maintenance_type_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05e1\u05d5\u05d2 \u05d4\u05ea\u05d7\u05d6\u05d5\u05e7\u05d4"
    },
    "visit_step": {
      "type": "number",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e9\u05dc\u05d1 \u05d1\u05e8\u05e6\u05e3 \u05d4\u05d1\u05d9\u05e7\u05d5\u05e8\u05d9\u05dd"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05de\u05ea\u05d5\u05d6\u05de\u05df"
    },
    "completed_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05e9\u05dc\u05de\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "scheduled",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1"
    },
    "parts_used": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_sku": {
            "type": "string"
          },
          "part_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          }
        }
      },
      "default": [],
      "description": "\u05d7\u05dc\u05e7\u05d9\u05dd \u05e9\u05e0\u05d5\u05e6\u05dc\u05d5"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    },
    "technician": {
      "type": "string",
      "description": "\u05d8\u05db\u05e0\u05d0\u05d9 \u05de\u05d1\u05e6\u05e2"
    },
    "auto_generated": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05e0\u05d5\u05e6\u05e8 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea"
    }
  },
  "required": [
    "unit_id",
    "customer_id",
    "scheduled_date",
    "status"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "data.technician": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.technician": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
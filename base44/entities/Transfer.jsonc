{
  "name": "Transfer",
  "type": "object",
  "properties": {
    "transfer_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05e2\u05d1\u05e8\u05d4 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9"
    },
    "from_warehouse_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05d7\u05e1\u05df \u05de\u05e7\u05d5\u05e8"
    },
    "to_warehouse_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05de\u05d7\u05e1\u05df \u05d9\u05e2\u05d3"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "in_transit",
        "completed"
      ],
      "default": "pending"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05dc\u05d4\u05e2\u05d1\u05e8\u05d4"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_sku": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "transfer_number",
    "from_warehouse_name",
    "to_warehouse_name",
    "items"
  ],
  "rls": {
    "create": {},
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
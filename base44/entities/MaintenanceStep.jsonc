{
  "name": "MaintenanceStep",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e4\u05e2\u05d5\u05dc\u05ea \u05d4\u05ea\u05d7\u05d6\u05d5\u05e7\u05d4"
    },
    "description": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05e7\u05e6\u05e8 \u05e9\u05dc \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4"
    },
    "explanation": {
      "type": "string",
      "description": "\u05d4\u05e1\u05d1\u05e8 \u05de\u05e4\u05d5\u05e8\u05d8 \u05dc\u05d1\u05d9\u05e6\u05d5\u05e2 \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4"
    },
    "brand_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05de\u05d5\u05ea\u05d2 - \u05e9\u05d9\u05d5\u05da \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05dc\u05de\u05d5\u05ea\u05d2 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 (\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9)"
    },
    "unit_type": {
      "type": "string",
      "description": "\u05e1\u05d5\u05d2 \u05d9\u05d7\u05d9\u05d3\u05d4 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05ea\u05d7\u05ea \u05d4\u05de\u05d5\u05ea\u05d2 (\u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9)"
    },
    "sort_order": {
      "type": "number",
      "description": "\u05e1\u05d3\u05e8 \u05d4\u05e6\u05d2\u05d4 \u05e9\u05dc \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d1\u05ea\u05d5\u05da brand+unit_type",
      "default": 9999
    },
    "parts_required": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "part_sku": {
            "type": "string"
          },
          "part_name": {
            "type": "string"
          },
          "quantity": {
            "type": "number",
            "default": 1
          }
        }
      },
      "default": [],
      "description": "\u05d7\u05dc\u05e7\u05d9\u05dd \u05e0\u05d3\u05e8\u05e9\u05d9\u05dd \u05dc\u05d1\u05d9\u05e6\u05d5\u05e2 \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05e2\u05dd \u05db\u05de\u05d5\u05d9\u05d5\u05ea"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
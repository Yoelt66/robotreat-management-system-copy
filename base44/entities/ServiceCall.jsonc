{
  "name": "ServiceCall",
  "type": "object",
  "properties": {
    "call_number": {
      "type": "string",
      "description": "Unique service call number"
    },
    "client_name": {
      "type": "string"
    },
    "client_phone": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "device": {
      "type": "string"
    },
    "device_id": {
      "type": "string"
    },
    "device_type": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "service_type": {
      "type": "string",
      "enum": [
        "repair",
        "inspection",
        "maintenance",
        "parts",
        "emergency",
        "installation",
        "other"
      ],
      "default": "repair"
    },
    "selected_procedure_id": {
      "type": "string",
      "description": "ID of the selected maintenance procedure template"
    },
    "selected_procedure_name": {
      "type": "string",
      "description": "Name of the selected maintenance procedure"
    },
    "procedure_steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "safety_note": {
            "type": "string"
          },
          "parts_required": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "part_sku": {
                  "type": "string"
                },
                "part_name": {
                  "type": "string"
                },
                "quantity": {
                  "type": "number"
                },
                "should_add": {
                  "type": "boolean",
                  "default": true
                }
              }
            }
          },
          "is_optional": {
            "type": "boolean",
            "default": false
          },
          "is_completed": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "default": []
    },
    "maintenance_steps_loaded": {
      "type": "boolean",
      "default": false,
      "description": "Whether maintenance procedure steps have been loaded"
    },
    "status": {
      "type": "string",
      "enum": [
        "temporary",
        "pending",
        "assigned",
        "in_progress",
        "completed",
        "final",
        "cancelled"
      ],
      "default": "temporary"
    },
    "assigned_to": {
      "type": "string"
    },
    "assigned_to_nickname": {
      "type": "string"
    },
    "parts_used": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "part_number": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          },
          "has_serial": {
            "type": "boolean",
            "default": false
          },
          "old_serial": {
            "type": "string"
          },
          "new_serial": {
            "type": "string"
          }
        }
      },
      "default": []
    },
    "notes": {
      "type": "string"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "no_travel": {
      "type": "boolean",
      "default": false
    },
    "no_work_hours": {
      "type": "boolean",
      "default": false
    },
    "is_draft": {
      "type": "boolean",
      "default": false
    },
    "photos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  },
  "required": [
    "client_name",
    "status"
  ]
}
{
  "name": "ServiceUnit",
  "type": "object",
  "properties": {
    "active": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d9\u05d7\u05d9\u05d3\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d4"
    },
    "customer_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05dc\u05e7\u05d5\u05d7"
    },
    "brand_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05d5\u05ea\u05d2"
    },
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d9\u05d7\u05d9\u05d3\u05d4"
    },
    "type": {
      "type": "string",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d9\u05d7\u05d9\u05d3\u05d4"
    },
    "model": {
      "type": "string",
      "description": "\u05d3\u05d2\u05dd"
    },
    "serial_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05e1\u05d9\u05d3\u05d5\u05e8\u05d9"
    },
    "installation_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05e7\u05e0\u05d4"
    },
    "visit_interval_months": {
      "type": "number",
      "default": 3,
      "description": "\u05de\u05e8\u05d5\u05d5\u05d7 \u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc \u05d1\u05d9\u05df \u05d1\u05d9\u05e7\u05d5\u05e8\u05d9\u05dd \u05d1\u05d7\u05d5\u05d3\u05e9\u05d9\u05dd"
    },
    "last_visit_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d1\u05d9\u05e7\u05d5\u05e8 \u05d0\u05d7\u05e8\u05d5\u05df"
    },
    "current_visit_step": {
      "type": "number",
      "default": 1,
      "description": "\u05e9\u05dc\u05d1 \u05d1\u05d9\u05e7\u05d5\u05e8 \u05e0\u05d5\u05db\u05d7\u05d9 \u05d1\u05e8\u05e6\u05e3"
    },
    "visit_sequence": {
      "type": "array",
      "description": "\u05e8\u05e6\u05e3 \u05d1\u05d9\u05e7\u05d5\u05e8\u05d9\u05dd \u05de\u05d7\u05d6\u05d5\u05e8\u05d9 \u2014 \u05d4\u05ea\u05d0\u05de\u05d4 \u05d0\u05d9\u05e9\u05d9\u05ea \u05dc\u05dc\u05e7\u05d5\u05d7",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "step_number": {
            "type": "number",
            "description": "\u05de\u05e1\u05e4\u05e8 \u05e9\u05dc\u05d1 \u05d1\u05e8\u05e6\u05e3 (1, 2, 3...)"
          },
          "maintenance_type_id": {
            "type": "string",
            "description": "\u05de\u05d6\u05d4\u05d4 \u05e1\u05d5\u05d2 \u05d4\u05ea\u05d7\u05d6\u05d5\u05e7\u05d4"
          },
          "maintenance_type_name": {
            "type": "string",
            "description": "\u05e9\u05dd \u05e1\u05d5\u05d2 \u05d4\u05ea\u05d7\u05d6\u05d5\u05e7\u05d4 (\u05dc\u05ea\u05e6\u05d5\u05d2\u05d4)"
          },
          "interval_months": {
            "type": "number",
            "description": "\u05de\u05e8\u05d5\u05d5\u05d7 \u05dc\u05e4\u05e0\u05d9 \u05e9\u05dc\u05d1 \u05d6\u05d4 \u05d1\u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u2014 \u05d3\u05e8\u05d9\u05e1\u05d4 \u05e2\u05dc \u05d1\u05e8\u05d9\u05e8\u05ea \u05d4\u05de\u05d7\u05d3\u05dc \u05e9\u05dc \u05d4\u05d9\u05d7\u05d9\u05d3\u05d4"
          },
          "step_configs": {
            "type": "array",
            "description": "\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05e4\u05e2\u05d5\u05dc\u05d5\u05ea \u05ea\u05d7\u05d6\u05d5\u05e7\u05d4 \u05d1\u05e9\u05dc\u05d1 \u05d6\u05d4 \u2014 \u05d3\u05e8\u05d9\u05e1\u05d4 \u05d9\u05d3\u05e0\u05d9\u05ea \u05e2\u05dc \u05d1\u05e8\u05d9\u05e8\u05ea \u05d4\u05de\u05d7\u05d3\u05dc \u05e9\u05dc \u05e1\u05d5\u05d2 \u05d4\u05ea\u05d7\u05d6\u05d5\u05e7\u05d4",
            "default": [],
            "items": {
              "type": "object",
              "properties": {
                "step_id": {
                  "type": "string",
                  "description": "\u05de\u05d6\u05d4\u05d4 \u05e4\u05e2\u05d5\u05dc\u05ea \u05ea\u05d7\u05d6\u05d5\u05e7\u05d4 (MaintenanceStep)"
                },
                "step_name": {
                  "type": "string",
                  "description": "\u05e9\u05dd \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 (\u05dc\u05ea\u05e6\u05d5\u05d2\u05d4)"
                },
                "manual_override": {
                  "type": "boolean",
                  "default": false,
                  "description": "\u05d4\u05d0\u05dd \u05d4\u05d2\u05d3\u05e8\u05d4 \u05d6\u05d5 \u05e9\u05d5\u05e0\u05ea\u05d4 \u05d9\u05d3\u05e0\u05d9\u05ea (\u05dc\u05d0 \u05ea\u05d9\u05d3\u05e8\u05e1 \u05d1\u05e2\u05d3\u05db\u05d5\u05df \u05ea\u05d1\u05e0\u05d9\u05ea)"
                },
                "enabled": {
                  "type": "boolean",
                  "default": true,
                  "description": "\u05d4\u05d0\u05dd \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d4 \u05e2\u05d1\u05d5\u05e8 \u05d9\u05d7\u05d9\u05d3\u05d4 \u05d6\u05d5"
                },
                "custom_parts": {
                  "type": "array",
                  "description": "\u05d7\u05dc\u05e7\u05d9\u05dd \u05de\u05d5\u05ea\u05d0\u05de\u05d9\u05dd \u05d0\u05d9\u05e9\u05d9\u05ea \u05dc\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d6\u05d5 \u2014 \u05d3\u05e8\u05d9\u05e1\u05d4 \u05e2\u05dc \u05d1\u05e8\u05d9\u05e8\u05ea \u05d4\u05de\u05d7\u05d3\u05dc \u05e9\u05dc \u05d4\u05e4\u05e2\u05d5\u05dc\u05d4",
                  "default": [],
                  "items": {
                    "type": "object",
                    "properties": {
                      "part_sku": {
                        "type": "string"
                      },
                      "part_name": {
                        "type": "string"
                      },
                      "quantity": {
                        "type": "number",
                        "default": 1
                      }
                    }
                  }
                },
                "use_custom_parts": {
                  "type": "boolean",
                  "default": false,
                  "description": "\u05d4\u05d0\u05dd \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05d7\u05dc\u05e7\u05d9\u05dd \u05d4\u05de\u05d5\u05ea\u05d0\u05de\u05d9\u05dd \u05d0\u05d9\u05e9\u05d9\u05ea \u05d1\u05de\u05e7\u05d5\u05dd \u05d1\u05e8\u05d9\u05e8\u05ea \u05d4\u05de\u05d7\u05d3\u05dc"
                }
              }
            }
          }
        }
      }
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "customer_id",
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
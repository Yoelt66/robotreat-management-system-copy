{
  "name": "User",
  "type": "object",
  "properties": {
    "nickname": {
      "type": "string",
      "description": "\u05db\u05d9\u05e0\u05d5\u05d9 \u05d0\u05d5 \u05e9\u05dd \u05e7\u05e6\u05e8 \u05dc\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "phone": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "department": {
      "type": "string",
      "description": "\u05de\u05d7\u05dc\u05e7\u05d4 \u05d0\u05d5 \u05ea\u05e4\u05e7\u05d9\u05d3 \u05d1\u05d0\u05e8\u05d2\u05d5\u05df"
    },
    "last_login": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05ea\u05d7\u05d1\u05e8\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05e0\u05d4"
    },
    "profile_completed": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05e9\u05dc\u05d9\u05dd \u05d0\u05ea \u05d4\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05e9\u05dc\u05d5"
    },
    "preferred_language": {
      "type": "string",
      "enum": [
        "he",
        "en"
      ],
      "default": "he",
      "description": "\u05e9\u05e4\u05d4 \u05de\u05d5\u05e2\u05d3\u05e4\u05ea"
    },
    "notifications_enabled": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05dc\u05d4\u05e6\u05d9\u05d2 \u05d4\u05ea\u05e8\u05d0\u05d5\u05ea \u05dc\u05de\u05e9\u05ea\u05de\u05e9"
    },
    "assigned_warehouse_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05d7\u05e1\u05df \u05d4\u05de\u05e9\u05d5\u05d9\u05da \u05dc\u05d8\u05db\u05e0\u05d0\u05d9"
    },
    "default_page": {
      "type": "string",
      "description": "\u05d4\u05d3\u05e3 \u05d4\u05e8\u05d0\u05e9\u05d9 \u05e9\u05d9\u05d5\u05e6\u05d2 \u05dc\u05de\u05e9\u05ea\u05de\u05e9 \u05dc\u05d0\u05d7\u05e8 \u05d4\u05ea\u05d7\u05d1\u05e8\u05d5\u05ea"
    },
    "default_page_filter": {
      "type": "string",
      "description": "\u05e4\u05d9\u05dc\u05d8\u05e8 \u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc \u05dc\u05d3\u05e3 \u05d4\u05e8\u05d0\u05e9\u05d9, \u05d0\u05dd \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9"
    },
    "dashboard_default_filter": {
      "type": "string",
      "description": "Legacy field for default filter"
    }
  },
  "required": [
    "nickname",
    "phone",
    "department",
    "last_login",
    "assigned_warehouse_id",
    "default_page",
    "default_page_filter",
    "dashboard_default_filter"
  ]
}
{
  "name": "StockTransaction",
  "type": "object",
  "properties": {
    "part_sku": {
      "type": "string",
      "description": "\u05de\u05e4\u05ea\u05d7 \u05d6\u05e8 \u05dc\u05de\u05e7\u05f4\u05d8 \u05d4\u05e4\u05e8\u05d9\u05d8",
      "indexed": true
    },
    "warehouse_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05d7\u05e1\u05df",
      "indexed": true
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "receipt",
        "consumption",
        "adjustment",
        "transfer_in",
        "transfer_out",
        "return",
        "initial",
        "count_correction"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05ea\u05e0\u05d5\u05e2\u05d4: \u05e7\u05d1\u05dc\u05d4, \u05e0\u05d9\u05e6\u05d5\u05dc, \u05ea\u05d9\u05e7\u05d5\u05df, \u05d4\u05e2\u05d1\u05e8\u05d4 \u05e0\u05db\u05e0\u05e1\u05ea/\u05d9\u05d5\u05e6\u05d0\u05ea, \u05d4\u05d7\u05d6\u05e8\u05d4, \u05d9\u05ea\u05e8\u05d4 \u05e4\u05ea\u05d9\u05d7\u05d4, \u05ea\u05d9\u05e7\u05d5\u05df \u05e1\u05e4\u05d9\u05e8\u05d4"
    },
    "quantity_delta": {
      "type": "number",
      "description": "\u05e9\u05d9\u05e0\u05d5\u05d9 \u05d1\u05db\u05de\u05d5\u05ea (\u05d7\u05d9\u05d5\u05d1\u05d9 = \u05e0\u05db\u05e0\u05e1, \u05e9\u05dc\u05d9\u05dc\u05d9 = \u05d9\u05d5\u05e6\u05d0)"
    },
    "quantity_before": {
      "type": "number",
      "description": "\u05db\u05de\u05d5\u05ea \u05dc\u05e4\u05e0\u05d9 \u05d4\u05ea\u05e0\u05d5\u05e2\u05d4"
    },
    "quantity_after": {
      "type": "number",
      "description": "\u05db\u05de\u05d5\u05ea \u05d0\u05d7\u05e8\u05d9 \u05d4\u05ea\u05e0\u05d5\u05e2\u05d4"
    },
    "reference_type": {
      "type": "string",
      "enum": [
        "order",
        "delivery_note",
        "service_call",
        "transfer",
        "manual",
        "import"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05de\u05e1\u05de\u05da \u05d4\u05de\u05e4\u05e0\u05d4"
    },
    "reference_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e1\u05de\u05da \u05d4\u05de\u05e4\u05e0\u05d4 (\u05d4\u05d6\u05de\u05e0\u05d4, \u05ea\u05e2\u05d5\u05d3\u05ea \u05de\u05e9\u05dc\u05d5\u05d7, \u05e7\u05e8\u05d9\u05d0\u05ea \u05e9\u05d9\u05e8\u05d5\u05ea, \u05d4\u05e2\u05d1\u05e8\u05d4)"
    },
    "performed_by": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d1\u05d9\u05e6\u05e2 \u05d0\u05ea \u05d4\u05ea\u05e0\u05d5\u05e2\u05d4"
    },
    "performed_by_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05e9\u05d1\u05d9\u05e6\u05e2 \u05d0\u05ea \u05d4\u05ea\u05e0\u05d5\u05e2\u05d4"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05e2\u05dc \u05d4\u05ea\u05e0\u05d5\u05e2\u05d4"
    }
  },
  "required": [
    "part_sku",
    "warehouse_id",
    "transaction_type",
    "quantity_delta"
  ]
}
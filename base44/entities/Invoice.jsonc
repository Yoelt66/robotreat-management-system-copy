{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea"
    },
    "supplier_number": {
      "type": "string",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05e1\u05e4\u05e7"
    },
    "supplier_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05e1\u05e4\u05e7"
    },
    "invoice_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea"
    },
    "amount": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05dc\u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "currency": {
      "type": "string",
      "enum": [
        "ILS",
        "USD",
        "EUR",
        "GBP"
      ],
      "default": "ILS",
      "description": "\u05de\u05d8\u05d1\u05e2"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "paid"
      ],
      "default": "open",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05ea\u05e9\u05dc\u05d5\u05dd"
    },
    "payment_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05ea\u05e9\u05dc\u05d5\u05dd \u05d1\u05e4\u05d5\u05e2\u05dc"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05dc\u05ea\u05e9\u05dc\u05d5\u05dd (\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea + 30 \u05d9\u05d5\u05dd)"
    },
    "invoice_file_url": {
      "type": "string",
      "description": "\u05e7\u05d9\u05e9\u05d5\u05e8 \u05dc\u05e7\u05d5\u05d1\u05e5 \u05d4\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea"
    },
    "invoice_file_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05e7\u05d5\u05d1\u05e5 \u05d4\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "invoice_number",
    "supplier_name",
    "invoice_date",
    "amount",
    "status"
  ]
}